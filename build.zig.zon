.{
    .name = .tsfm_pg,
    .version = "0.1.0",
    .fingerprint = 0x4cca1d9a3a2b8a05,
    .minimum_zig_version = "0.17.1",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "extension",
        "src",
        "sql",
        "expected",
        "tests",
        "scripts",
        "README.md",
        "LICENSE",
        "NOTICE",
        "Dockerfile",
    },
    .dependencies = .{
        .pgzx = .{
            // pgzx's published package omits build.zig.zon from its .paths, so
            // a URL dependency loses its own dependencies. Use the sibling
            // checkout in this workspace; pin by commit when pgzx fixes that.
            .path = "../pgzx",
        },
        .tsfm = .{
            .url = "git+https://github.com/barddoo/tsfm-zig.git#5ec4ab7f517486ccc8f0523e406a250f06974fe3",
            .hash = "tsfm-0.1.0-Q8PMS7FJBAChQ3aJQlHxOx0Z348c_ITlRmsVg09DmxEg",
        },
    },
}
