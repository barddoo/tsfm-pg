# shellcheck shell=bash
# Local dev environment — uses the pgzx CLI fetched by zig build.
# Run `direnv allow` once; after that `pgzx`, `zig build`, psql all just work.

export PRJ_ROOT="$PWD"

# Build the pgzx CLI from the fetched package if not already built.
_pgzx_pkg=$(ls -d "$PWD/zig-pkg/pgzx-"* 2>/dev/null | head -1 || true)
if [[ -n "$_pgzx_pkg" && ! -x "$PWD/zig-out/bin/pgzx" ]]; then
    echo "building pgzx CLI..."
    (cd "$_pgzx_pkg" && zig build cli --prefix "$PWD/zig-out")
fi

if [[ -x "$PWD/zig-out/bin/pgzx" ]]; then
    PATH_add zig-out/bin
    eval "$(pgzx env)"
fi
