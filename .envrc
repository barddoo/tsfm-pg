# shellcheck shell=bash
# Local dev environment — no Nix required.
# Requires direnv. For the full dev environment use `dev/docker/`.

export PRJ_ROOT="$PWD"
export PG_HOME="${PG_HOME:-$(brew --prefix postgresql@18 2>/dev/null || echo "$PRJ_ROOT/out/18")}"
export PG_CONFIG="$PG_HOME/bin/pg_config"
export PATH="$PG_HOME/bin:$PATH"
